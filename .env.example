PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portfoliodb

# جیمیلی که پیام‌ها بهش ارسال میشن
GMAIL_USER=your-email@gmail.com
# این رمز معمولی جیمیلت نیست! باید از حساب گوگل یه "App Password" بسازی
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# توکن ربات تلگرامت (از BotFather می‌گیری)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# آیدی عددی چتی که پیام‌ها باید توش بیفته (خودت یا یه گروه)
TELEGRAM_CHAT_ID=123456789
