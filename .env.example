# این فایل رو کپی کن به .env و مقدارها رو پر کن. فایل .env هرگز نباید توی گیت بره.

# روی هاست بذار production. روی کامپیوتر خودت development
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portfoliodb

# جیمیلی که پیام‌ها بهش ارسال میشن
GMAIL_USER=your-email@gmail.com
# این رمز معمولی جیمیلت نیست! باید از حساب گوگل یه "App Password" بسازی
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# توکن ربات تلگرامت (از BotFather می‌گیری)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# آیدی عددی چتی که پیام‌ها باید توش بیفته (خودت یا یه گروه)
TELEGRAM_CHAT_ID=123456789

# روی هاست (لیارا و...) سایت پشت پروکسیه: 1 بذار تا IP واقعی بازدیدکننده خونده بشه
TRUST_PROXY=0

# فقط اگه صفحه روی یه دامنه‌ی دیگه باشه لازمه (با ویرگول جدا کن). مثال:
# CORS_ORIGINS=https://amireiny.ir,https://www.amireiny.ir
CORS_ORIGINS=
